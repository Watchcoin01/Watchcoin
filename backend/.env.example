# Copy this file to .env and fill it in.
PORT=3000
NODE_ENV=development

# REQUIRED in production. Use a long random string, for example: openssl rand -hex 32
JWT_SECRET=

# ---- Owner setup ----
# Only this email may become the owner (recommended).
ADMIN_EMAIL=you@example.com
# One-time code that makes an account the owner. It only works while there is no owner.
# Use a long random string (openssl rand -hex 16). You can remove it once you are the owner.
ADMIN_SETUP_CODE=
# Staff must turn on two-step login to use the admin dashboard. Default: true in production.
ADMIN_REQUIRE_2FA=
# Staff logins expire after this many hours (users stay logged in for 30 days).
STAFF_SESSION_HOURS=12
# Key that encrypts two-step login secrets in the database. Defaults to JWT_SECRET.
# Set it if you might change JWT_SECRET later, or staff will have to set up two-step login again.
DATA_KEY=

# Where the SQLite database file lives. Put it on a persistent disk and back it up.
DB_PATH=./data/watchcoin.db

# Your frontend address(es), comma separated. Use * only while developing.
CORS_ORIGIN=*
# Public address of this server, used in email links and invite links.
PUBLIC_URL=http://localhost:3000

# Behind a proxy or host such as Render, Railway or Nginx? Set this to true so rate limits see real IPs.
TRUST_PROXY=false

# Day boundary offset from UTC in minutes (Ghana = 0).
TZ_OFFSET_MINUTES=0
# Starting price of 1 WTC in USDT. The admin can change it later with PUT /api/admin/settings.
TOKEN_PRICE_USDT=0.005301
# Accounts allowed per IP address.
MAX_ACCOUNTS_PER_IP=3
# Require a verified email before a user can start tasks (needs a real mail provider in src/mailer.js).
REQUIRE_EMAIL_VERIFICATION=false

# ---- Paystack: automatic premium payments with Mobile Money and cards ----
# Secret key from Paystack, Settings > API Keys & Webhooks (sk_test_... while testing, sk_live_... when live).
PAYSTACK_SECRET_KEY=
# Currency to charge in. GHS for Ghana, NGN for Nigeria, KES for Kenya, ZAR for South Africa.
PAYSTACK_CURRENCY=GHS
# How much 1 USDT costs in that currency. The owner can change it later in Settings.
PAYSTACK_FX_RATE=
